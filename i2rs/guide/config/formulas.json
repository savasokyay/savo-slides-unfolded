, \\quad IDCG@K = \\sum_{k=1}^{\\min(K,|Rel_u|)} \\frac{1}{\\log_2(k+1)}", "expanded": "DCG@{{K}} = {{terms}}", "numeric": "nDCG@{{K}} = \\frac{ {{dcg}} }{ {{idcg}} } = {{ndcg}}", "slots": {"K": "int", "terms": "terms", "dcg": "num", "idcg": "num", "ndcg": "num"}}, "average_precision_at_k": {"label_key": "formula.average_precision_at_k", "symbolic": "AP@K = \\frac{1}{\\min(K, |Rel_u|)} \\sum_{k=1}^{K} rel_k \\cdot P@k", "expanded": "AP@{{K}} = \\frac{ {{terms}} }{ {{norm}} }", "numeric": "AP@{{K}} = \\frac{ {{sum}} }{ {{norm}} } = {{ap}}", "slots": {"K": "int", "terms": "terms", "sum": "num", "norm": "int", "ap": "num"}}, "reciprocal_rank": {"label_key": "formula.reciprocal_rank", "symbolic": "RR = \\frac{1}{\\text{rank of the first hit}}, \\qquad HR@K = \\mathbb{1}\\big[\\,|L_K \\cap Rel_u| > 0\\,\\big]", "numeric": "RR = \\frac{1}{ {{first_hit}} } = {{rr}}, \\qquad HR@{{K}} = {{hr}}", "slots": {"first_hit": "int", "rr": "num", "K": "int", "hr": "int"}}, "mean_over_users": {"label_key": "formula.mean_over_users", "symbolic": "\\overline{M@K} = \\frac{1}{|U_{test}|} \\sum_{u \\in U_{test}} M_u@K", "numeric": "\\overline{ {{metric}} } = \\frac{ {{sum}} }{ {{n_users}} } = {{mean}}", "slots": {"metric": "text", "sum": "num", "n_users": "int", "mean": "num"}}, "catalog_coverage": {"label_key": "formula.catalog_coverage", "symbolic": "Cov@K = \\frac{\\big|\\bigcup_{u} L_K(u)\\big|}{|I|}", "numeric": "Cov@{{K}} = \\frac{ {{n_recommended}} }{ {{n_items}} } = {{coverage}}", "slots": {"K": "int", "n_recommended": "int", "n_items": "int", "coverage": "num"}}, "novelty": {"label_key": "formula.novelty", "symbolic": "Nov@K = \\frac{1}{|U|}\\sum_{u} \\frac{1}{K}\\sum_{i \\in L_K(u)} -\\log_2 \\frac{pop_i}{|U|}", "numeric": "Nov@{{K}} = {{novelty}}, \\qquad \\overline{pop}@{{K}} = {{avg_pop}}, \\qquad Gini = {{gini}}", "slots": {"K": "int", "novelty": "num", "avg_pop": "num", "gini": "num"}}, "rating_errors": {"label_key": "formula.rating_errors", "symbolic": "MAE = \\frac{1}{|T|}\\sum_{(u,i)\\in T} |r_{u,i} - \\hat r_{u,i}|, \\qquad RMSE = \\sqrt{\\frac{1}{|T|}\\sum_{(u,i)\\in T} (r_{u,i} - \\hat r_{u,i})^2}", "expanded": "MAE = \\frac{ {{terms}} }{ {{n}} }", "numeric": "MAE = {{mae}}, \\qquad RMSE = {{rmse}} \\quad (|T| = {{n}},\\; \\text{coverage } {{coverage}})", "slots": {"terms": "terms", "n": "int", "mae": "num", "rmse": "num", "coverage": "num"}}, "confusion_rates": {"label_key": "formula.confusion_rates", "symbolic": "TPR(t) = \\frac{TP}{P}, \\qquad FPR(t) = \\frac{FP}{N}, \\qquad Prec(t) = \\frac{TP}{TP + FP} \\qquad \\text{with } \\hat y = \\mathbb{1}[\\hat r \\ge t]", "numeric": "TPR = \\frac{ {{tp}} }{ {{p}} } = {{tpr}}, \\qquad FPR = \\frac{ {{fp}} }{ {{n}} } = {{fpr}}, \\qquad Prec = \\frac{ {{tp}} }{ {{tp}} + {{fp}} } = {{precision}}", "slots": {"tp": "int", "p": "int", "tpr": "num", "fp": "int", "n": "int", "fpr": "num", "precision": "num"}}, "auc_trapezoid": {"label_key": "formula.auc_trapezoid", "symbolic": "AUC = \\sum_{j} (FPR_j - FPR_{j-1})\\,\\frac{TPR_j + TPR_{j-1}}{2} = P(\\hat r_{pos} > \\hat r_{neg}) + \\tfrac{1}{2} P(\\hat r_{pos} = \\hat r_{neg})", "expanded": "AUC = {{terms}}", "numeric": "AUC = {{auc}} \\quad (\\text{pairwise check: } {{pairwise}})", "slots": {"terms": "terms", "auc": "num", "pairwise": "num"}}, "binarised_point": {"label_key": "formula.binarised_point", "symbolic": "\\hat y = \\mathbb{1}[\\hat r \\ge \\tau] \\;\\Rightarrow\\; \\text{one point } (FPR_\\tau, TPR_\\tau), \\qquad \\text{\"AUC\"} = \\frac{TPR_\\tau + (1 - FPR_\\tau)}{2}", "numeric": "(FPR_\\tau, TPR_\\tau) = ({{fpr}}, {{tpr}}), \\qquad \\frac{ {{tpr}} + (1 - {{fpr}}) }{2} = {{bal_acc}}", "slots": {"fpr": "num", "tpr": "num", "bal_acc": "num"}, "warn_key": "pitfall.binarised_point"}}